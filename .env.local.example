# Cloudinary (required for all next-cloudinary image components)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Google Analytics (GA4 Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID= G-XXXXXXXXXX

# Microsoft Clarity (Project ID)
NEXT_PUBLIC_CLARITY_PROJECT_ID= your_clarity_project_id

# Public site URL, used for metadata / OpenGraph absolute URLs
NEXT_PUBLIC_SITE_URL=https://sapphirebysthavar.com
